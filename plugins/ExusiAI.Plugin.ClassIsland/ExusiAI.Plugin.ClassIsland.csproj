<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>ExusiAI.Plugin.ClassIsland</AssemblyName>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Description>In-process host for the original ClassIsland Avalonia UI.</Description>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <EnableClassIslandNative Condition="'$(EnableClassIslandNative)' == ''">true</EnableClassIslandNative>
  </PropertyGroup>
  <ItemGroup>
    <!-- The in-process ClassIsland runtime needs Metadata's Immutable 9.x dependency. -->
    <PackageReference Include="System.Collections.Immutable" />
    <!-- WPF must bind SystemEvents 9.x before ClassIsland loads into the same process. -->
    <PackageReference Include="Microsoft.Win32.SystemEvents" />
    <ProjectReference Include="..\..\src\ExusiAI.Extension.Abstractions\ExusiAI.Extension.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\ExusiAI.Extension.SDK\ExusiAI.Extension.SDK.csproj" />
    <ProjectReference Include="..\..\src\ExusiAI.Extension.Wpf\ExusiAI.Extension.Wpf.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="package.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <None Include="README.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <None Include="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>
  <Target Name="PackageNativeClassIsland" AfterTargets="Build"
          Condition="'$(EnableClassIslandNative)' == 'true'">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\..\..\third_party\ClassIsland"
          Command="dotnet build ClassIsland.Desktop\ClassIsland.Desktop.csproj --configuration $(Configuration) -p:PublishBuilding=true -p:PublishPlatform=windows -p:ClassIsland_PlatformTarget=x64 -p:UseAppHost=false -maxcpucount:1 -nodeReuse:false" />
    <PropertyGroup>
      <NativeOutput>$(MSBuildProjectDirectory)\..\..\third_party\ClassIsland\ClassIsland.Desktop\bin\$(Configuration)\net8.0-windows10.0.19041.0\</NativeOutput>
    </PropertyGroup>
    <Error Condition="!Exists('$(NativeOutput)ClassIsland.Desktop.dll') Or !Exists('$(NativeOutput)ClassIsland.dll')"
           Text="The bundled original ClassIsland runtime is incomplete." />
    <ItemGroup>
      <NativeClassIslandFiles Include="$(NativeOutput)**\*" Exclude="$(NativeOutput)**\*.exe" />
    </ItemGroup>
    <Delete Files="$(TargetDir)NativeClassIsland\ClassIsland.Desktop.exe;$(TargetDir)NativeClassIsland\ClassIsland.exe" />
    <Copy SourceFiles="@(NativeClassIslandFiles)"
          DestinationFolder="$(TargetDir)NativeClassIsland\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
