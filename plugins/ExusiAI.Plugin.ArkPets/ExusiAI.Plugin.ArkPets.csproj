<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>ExusiAI.Plugin.ArkPets</AssemblyName>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Description>ArkPets-compatible desktop pet integration for ExusiAI.</Description>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\ExusiAI.Extension.Abstractions\ExusiAI.Extension.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\ExusiAI.Extension.SDK\ExusiAI.Extension.SDK.csproj" />
    <ProjectReference Include="..\..\src\ExusiAI.Extension.Wpf\ExusiAI.Extension.Wpf.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="package.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <None Include="README.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <None Include="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <None Include="Runtime\ArkPets-v3.13.1.zip.part*"
          CopyToOutputDirectory="Never" CopyToPublishDirectory="Never"
          TargetPath="Runtime\%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="RemovePreviouslyBundledExternalRuntime" AfterTargets="Build">
    <ItemGroup><OldBundledRuntimeParts Include="$(TargetDir)Runtime\ArkPets-v3.13.1.zip.part*" /></ItemGroup>
    <Delete Files="@(OldBundledRuntimeParts)" />
  </Target>
</Project>
