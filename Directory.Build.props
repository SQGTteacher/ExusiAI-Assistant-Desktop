<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <Version>0.1.0-developer-beta</Version>
    <!-- Preserve the CLR identity requested by existing preview.4 plugins. -->
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <BuildNumber Condition="'$(BuildNumber)' == ''">local</BuildNumber>
    <InformationalVersion>$(Version)+build.$(BuildNumber)</InformationalVersion>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <EnableWindowsTargeting Condition="$([System.String]::Copy('$(TargetFramework)').Contains('-windows'))">true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
