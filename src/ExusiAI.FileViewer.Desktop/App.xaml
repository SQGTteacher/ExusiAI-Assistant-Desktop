<Application x:Class="ExusiAI.FileViewer.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0D1017" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#171B24" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#11151D" />
    <SolidColorBrush x:Key="BorderBrush" Color="#2A303C" />
    <SolidColorBrush x:Key="AccentBrush" Color="#E6507A" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#33E6507A" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F6F7FA" />
    <Style TargetType="Window">
      <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,7" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
    </Style>
  </Application.Resources>
</Application>
