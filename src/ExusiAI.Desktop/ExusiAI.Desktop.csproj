<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ExusiAI.Core\ExusiAI.Core.csproj" />
    <ProjectReference Include="..\ExusiAI.Extension.Abstractions\ExusiAI.Extension.Abstractions.csproj" />
    <ProjectReference Include="..\ExusiAI.Extension.Runtime\ExusiAI.Extension.Runtime.csproj" />
    <ProjectReference Include="..\ExusiAI.Extension.Wpf\ExusiAI.Extension.Wpf.csproj" />
    <ProjectReference Include="..\ExusiAI.Infrastructure\ExusiAI.Infrastructure.csproj" />
    <ProjectReference Include="..\ExusiAI.Marketplace\ExusiAI.Marketplace.csproj" />
    <ProjectReference Include="..\ExusiAI.Theme\ExusiAI.Theme.csproj" />
    <ProjectReference Include="..\..\plugins\ExusiAI.Plugin.ClassIsland\ExusiAI.Plugin.ClassIsland.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\plugins\ExusiAI.Plugin.FileViewer\ExusiAI.Plugin.FileViewer.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\plugins\ExusiAI.Plugin.RollCall\ExusiAI.Plugin.RollCall.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\plugins\ExusiAI.Plugin.ArkPets\ExusiAI.Plugin.ArkPets.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\ExusiAI.FileViewer.Desktop\ExusiAI.FileViewer.Desktop.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
  <Target Name="RemoveLegacySamplePackage" BeforeTargets="Build;Publish">
    <RemoveDir Directories="$(TargetDir)packages\exusiai.sample;$(PublishDir)packages\exusiai.sample;$(TargetDir)packages\exusiai.misha-showcase;$(PublishDir)packages\exusiai.misha-showcase" />
  </Target>
  <Target Name="CopyFileViewerPackage" AfterTargets="Build">
    <PropertyGroup><FileViewerPackageDir>$(TargetDir)packages\exusiai.file-viewer</FileViewerPackageDir></PropertyGroup>
    <MakeDir Directories="$(FileViewerPackageDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\..\plugins\ExusiAI.Plugin.FileViewer\bin\$(Configuration)\net8.0-windows\ExusiAI.Plugin.FileViewer.dll" DestinationFolder="$(FileViewerPackageDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\..\plugins\ExusiAI.Plugin.FileViewer\package.json;$(MSBuildProjectDirectory)\..\..\plugins\ExusiAI.Plugin.FileViewer\README.md" DestinationFolder="$(FileViewerPackageDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\ExusiAI.Extension.SDK\bin\$(Configuration)\net8.0\ExusiAI.Extension.SDK.dll" DestinationFolder="$(FileViewerPackageDir)" />
    <ItemGroup><FileViewerDesktopFiles Include="$(MSBuildProjectDirectory)\..\ExusiAI.FileViewer.Desktop\bin\$(Configuration)\net8.0-windows\**\*" /></ItemGroup>
    <Copy SourceFiles="@(FileViewerDesktopFiles)" DestinationFolder="$(TargetDir)viewer\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyClassIslandPackage" AfterTargets="Build">
    <PropertyGroup>
      <ClassIslandPackageDir>$(TargetDir)packages\exusiai.classisland</ClassIslandPackageDir>
    </PropertyGroup>
    <RemoveDir Directories="$(ClassIslandPackageDir)" />
    <MakeDir Directories="$(ClassIslandPackageDir)" />
    <ItemGroup><ClassIslandBuiltFiles Include="$(MSBuildProjectDirectory)\..\..\plugins\ExusiAI.Plugin.ClassIsland\bin\$(Configuration)\net8.0-windows\**\*" /></ItemGroup>
    <Copy SourceFiles="@(ClassIslandBuiltFiles)" DestinationFolder="$(ClassIslandPackageDir)\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\..\plugins\ExusiAI.Plugin.ClassIsland\package.json;$(MSBuildProjectDirectory)\..\..\plugins\ExusiAI.Plugin.ClassIsland\README.md;$(MSBuildProjectDirectory)\..\..\plugins\ExusiAI.Plugin.ClassIsland\THIRD_PARTY_NOTICES.md" DestinationFolder="$(ClassIslandPackageDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\ExusiAI.Extension.SDK\bin\$(Configuration)\net8.0\ExusiAI.Extension.SDK.dll" DestinationFolder="$(ClassIslandPackageDir)" />
  </Target>
  <Target Name="CopyRollCallPackage" AfterTargets="Build">
    <PropertyGroup><RollCallPackageDir>$(TargetDir)packages\exusiai.roll-call</RollCallPackageDir></PropertyGroup>
    <MakeDir Directories="$(RollCallPackageDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\..\plugins\ExusiAI.Plugin.RollCall\bin\$(Configuration)\net8.0-windows\ExusiAI.Plugin.RollCall.dll" DestinationFolder="$(RollCallPackageDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\..\plugins\ExusiAI.Plugin.RollCall\package.json;$(MSBuildProjectDirectory)\..\..\plugins\ExusiAI.Plugin.RollCall\README.md" DestinationFolder="$(RollCallPackageDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\ExusiAI.Extension.SDK\bin\$(Configuration)\net8.0\ExusiAI.Extension.SDK.dll" DestinationFolder="$(RollCallPackageDir)" />
  </Target>
  <Target Name="CopyArkPetsPackage" AfterTargets="Build">
    <PropertyGroup><ArkPetsPackageDir>$(TargetDir)packages\exusiai.ark-pets</ArkPetsPackageDir></PropertyGroup>
    <MakeDir Directories="$(ArkPetsPackageDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\..\plugins\ExusiAI.Plugin.ArkPets\bin\$(Configuration)\net8.0-windows\ExusiAI.Plugin.ArkPets.dll" DestinationFolder="$(ArkPetsPackageDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\..\plugins\ExusiAI.Plugin.ArkPets\package.json;$(MSBuildProjectDirectory)\..\..\plugins\ExusiAI.Plugin.ArkPets\README.md;$(MSBuildProjectDirectory)\..\..\plugins\ExusiAI.Plugin.ArkPets\THIRD_PARTY_NOTICES.md" DestinationFolder="$(ArkPetsPackageDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\ExusiAI.Extension.SDK\bin\$(Configuration)\net8.0\ExusiAI.Extension.SDK.dll" DestinationFolder="$(ArkPetsPackageDir)" />
  </Target>
  <Target Name="CopyClassIslandPackageToPublish" AfterTargets="Publish">
    <PropertyGroup><ClassIslandPublishPackageDir>$(PublishDir)packages\exusiai.classisland</ClassIslandPublishPackageDir></PropertyGroup>
    <RemoveDir Directories="$(ClassIslandPublishPackageDir)" />
    <MakeDir Directories="$(ClassIslandPublishPackageDir)" />
    <ItemGroup><ClassIslandPublishFiles Include="$(MSBuildProjectDirectory)\..\..\plugins\ExusiAI.Plugin.ClassIsland\bin\$(Configuration)\net8.0-windows\**\*" /></ItemGroup>
    <Copy SourceFiles="@(ClassIslandPublishFiles)" DestinationFolder="$(ClassIslandPublishPackageDir)\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\..\plugins\ExusiAI.Plugin.ClassIsland\package.json;$(MSBuildProjectDirectory)\..\..\plugins\ExusiAI.Plugin.ClassIsland\README.md;$(MSBuildProjectDirectory)\..\..\plugins\ExusiAI.Plugin.ClassIsland\THIRD_PARTY_NOTICES.md" DestinationFolder="$(ClassIslandPublishPackageDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\ExusiAI.Extension.SDK\bin\$(Configuration)\net8.0\ExusiAI.Extension.SDK.dll" DestinationFolder="$(ClassIslandPublishPackageDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyFileViewerPackageToPublish" AfterTargets="Publish">
    <PropertyGroup><FileViewerPublishPackageDir>$(PublishDir)packages\exusiai.file-viewer</FileViewerPublishPackageDir></PropertyGroup>
    <MakeDir Directories="$(FileViewerPublishPackageDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\..\plugins\ExusiAI.Plugin.FileViewer\bin\$(Configuration)\net8.0-windows\ExusiAI.Plugin.FileViewer.dll" DestinationFolder="$(FileViewerPublishPackageDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\..\plugins\ExusiAI.Plugin.FileViewer\package.json;$(MSBuildProjectDirectory)\..\..\plugins\ExusiAI.Plugin.FileViewer\README.md" DestinationFolder="$(FileViewerPublishPackageDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\ExusiAI.Extension.SDK\bin\$(Configuration)\net8.0\ExusiAI.Extension.SDK.dll" DestinationFolder="$(FileViewerPublishPackageDir)" SkipUnchangedFiles="true" />
    <ItemGroup><FileViewerDesktopPublishFiles Include="$(MSBuildProjectDirectory)\..\ExusiAI.FileViewer.Desktop\bin\$(Configuration)\net8.0-windows\**\*" /></ItemGroup>
    <Copy SourceFiles="@(FileViewerDesktopPublishFiles)" DestinationFolder="$(PublishDir)viewer\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyArkPetsPackageToPublish" AfterTargets="Publish">
    <PropertyGroup><ArkPetsPublishPackageDir>$(PublishDir)packages\exusiai.ark-pets</ArkPetsPublishPackageDir></PropertyGroup>
    <MakeDir Directories="$(ArkPetsPublishPackageDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\..\plugins\ExusiAI.Plugin.ArkPets\bin\$(Configuration)\net8.0-windows\ExusiAI.Plugin.ArkPets.dll" DestinationFolder="$(ArkPetsPublishPackageDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\..\plugins\ExusiAI.Plugin.ArkPets\package.json;$(MSBuildProjectDirectory)\..\..\plugins\ExusiAI.Plugin.ArkPets\README.md;$(MSBuildProjectDirectory)\..\..\plugins\ExusiAI.Plugin.ArkPets\THIRD_PARTY_NOTICES.md" DestinationFolder="$(ArkPetsPublishPackageDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\ExusiAI.Extension.SDK\bin\$(Configuration)\net8.0\ExusiAI.Extension.SDK.dll" DestinationFolder="$(ArkPetsPublishPackageDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyRollCallPackageToPublish" AfterTargets="Publish">
    <PropertyGroup><RollCallPublishPackageDir>$(PublishDir)packages\exusiai.roll-call</RollCallPublishPackageDir></PropertyGroup>
    <MakeDir Directories="$(RollCallPublishPackageDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\..\plugins\ExusiAI.Plugin.RollCall\bin\$(Configuration)\net8.0-windows\ExusiAI.Plugin.RollCall.dll" DestinationFolder="$(RollCallPublishPackageDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\..\plugins\ExusiAI.Plugin.RollCall\package.json;$(MSBuildProjectDirectory)\..\..\plugins\ExusiAI.Plugin.RollCall\README.md" DestinationFolder="$(RollCallPublishPackageDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\ExusiAI.Extension.SDK\bin\$(Configuration)\net8.0\ExusiAI.Extension.SDK.dll" DestinationFolder="$(RollCallPublishPackageDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
