<UserControl x:Class="ExusiAI.Desktop.ThemePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1120" HorizontalAlignment="Stretch" Margin="0,0,8,8">
            <TextBlock Text="外观与主题" Style="{StaticResource PageTitle}" />
            <TextBlock Text="选一种舒服的配色，变化即刻生效。" Style="{StaticResource PageSubtitle}" />
            <TextBlock Text="配色方案" Style="{StaticResource SectionHeading}" />
            <ListBox ItemsSource="{Binding OptionsView}" SelectedItem="{Binding SelectedOption}"
                     Style="{StaticResource NavigationList}" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="配色方案">
                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" Margin="4,12,0,8" /></DataTemplate></GroupStyle.HeaderTemplate>
                        <GroupStyle.Panel><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></GroupStyle.Panel>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource SelectableItem}">
                        <Setter Property="Width" Value="240" /><Setter Property="Margin" Value="0,0,12,12" />
                        <Setter Property="Padding" Value="10" /><Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <Border Height="100" CornerRadius="5" Background="{Binding Palette.Background}" BorderBrush="{Binding Palette.Border}" BorderThickness="1" Padding="8">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="12" /><RowDefinition /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Border Width="6" Height="6" Background="{Binding Palette.Accent}" CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                    <StackPanel Grid.Row="1" Margin="0,5,8,0">
                                        <Border Height="10" CornerRadius="2" Background="{Binding Palette.AccentSoft}" />
                                        <Border Height="3" Margin="4,8,8,0" Background="{Binding Palette.TextSecondary}" Opacity="0.5" />
                                        <Border Height="3" Margin="4,8,8,0" Background="{Binding Palette.TextSecondary}" Opacity="0.5" />
                                    </StackPanel>
                                    <Border Grid.Row="1" Grid.Column="1" Background="{Binding Palette.Surface}" CornerRadius="4" Padding="10">
                                        <StackPanel><Border Height="5" Width="54" Background="{Binding Palette.TextPrimary}" HorizontalAlignment="Left" CornerRadius="2" />
                                            <Border Height="3" Margin="0,7,12,0" Background="{Binding Palette.TextSecondary}" Opacity="0.4" />
                                            <Border Height="15" Width="42" Margin="0,10,0,0" Background="{Binding Palette.Accent}" CornerRadius="3" HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="2,10,0,0" />
                            <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="2,5,0,0" MinHeight="36" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="窗口材质" Style="{StaticResource SectionHeading}" />
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0"><TextBlock Text="背景效果" FontWeight="SemiBold" /><TextBlock Text="{Binding SelectedBackdrop.Description}" Style="{StaticResource Caption}" Margin="0,6,0,0" /></StackPanel>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding BackdropOptions}" SelectedItem="{Binding SelectedBackdrop}"
                              DisplayMemberPath="Name" VerticalAlignment="Center" AutomationProperties.Name="窗口材质" />
                </Grid>
            </Border>
            <TextBlock Text="窗口材质取决于 Windows 版本。不支持的效果将自动回退。信息岛主题在 ClassIsland 设置中单独调整。"
                       Style="{StaticResource Caption}" Margin="2,14,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
