<UserControl x:Class="ExusiAI.Desktop.ThemePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Text="外观与主题" Style="{StaticResource PageTitle}" />
            <TextBlock Text="配色卡片会随窗口宽度自动换行；窗口材质与配色独立设置。" Style="{StaticResource PageSubtitle}" />

            <TextBlock Text="配色方案" FontSize="17" FontWeight="SemiBold" Margin="0,24,0,10" />
            <ListBox ItemsSource="{Binding Options}"
                     SelectedItem="{Binding SelectedOption}"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" ItemWidth="255" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Width" Value="255" />
                        <Setter Property="Margin" Value="4" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ThemeCard" Style="{StaticResource Card}" Padding="13">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ThemeCard" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            <Setter TargetName="ThemeCard" Property="BorderThickness" Value="2" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <Border Height="48" CornerRadius="5"
                                    Background="{Binding Palette.Background}"
                                    BorderBrush="{Binding Palette.Border}"
                                    BorderThickness="1" Margin="0,0,0,11">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse Width="12" Height="12" Fill="{Binding Palette.Accent}" Margin="2" />
                                    <Ellipse Width="12" Height="12" Fill="{Binding Palette.TextPrimary}" Margin="2" />
                                    <Ellipse Width="12" Height="12" Fill="{Binding Palette.Warning}" Margin="2" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Description}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="窗口材质" FontSize="17" FontWeight="SemiBold" Margin="0,24,0,10" />
            <ListBox ItemsSource="{Binding BackdropOptions}"
                     SelectedItem="{Binding SelectedBackdrop}"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" ItemWidth="310" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Width" Value="310" />
                        <Setter Property="Margin" Value="4" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="BackdropCard" Style="{StaticResource Card}" Padding="15">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="BackdropCard" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            <Setter TargetName="BackdropCard" Property="BorderThickness" Value="2" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Description}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="云母与亚克力使用 Windows 11 DWM；不支持时系统会安全回退，不启用高风险透明窗口模式。"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                       Margin="4,10,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>