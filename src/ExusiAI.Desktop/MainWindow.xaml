<Window x:Class="ExusiAI.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ExusiAI Assistant" Width="1260" Height="800" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource AppBackgroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="7" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="ChromeRoot" Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource WindowTopBarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="196" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Border Width="28" Height="28" CornerRadius="7" Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="E" Foreground="White" FontSize="14" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ExusiAI" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="Assistant" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,-1,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Border Width="3" Height="18" CornerRadius="1.5" Background="{DynamicResource AccentWarmBrush}" Margin="0,0,10,0" />
                    <TextBlock x:Name="SectionTitle" Text="{Binding SelectedItem.Title}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource GhostButton}" Width="46" Height="46" Padding="0" ToolTip="最小化" Click="Minimize_OnClick">
                        <Path Data="M4,12 H20" Width="14" Height="14" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" />
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Width="46" Height="46" Padding="0" ToolTip="最大化或还原" Click="Maximize_OnClick">
                        <Path Data="M5,5 H19 V19 H5 Z" Width="14" Height="14" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" />
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Width="46" Height="46" Padding="0" ToolTip="隐藏到系统托盘" Click="Close_OnClick">
                        <Path Data="M5,5 L19,19 M19,5 L5,19" Width="14" Height="14" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource NavRailBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="8,10,8,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListBox ItemsSource="{Binding NavigationItems}" SelectedItem="{Binding SelectedItem}" Style="{StaticResource NavRailList}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Path Data="{Binding IconData}" Width="20" Height="20" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                      StrokeThickness="1.55" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,10,0,2">
                        <Border Width="34" Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,10" />
                        <TextBlock Text="PRE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding PreviewVersion}" FontSize="8.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                   ToolTip="{Binding PreviewVersion}" TextTrimming="CharacterEllipsis" Width="48" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl x:Name="PageHost" Grid.Column="1" Content="{Binding CurrentPage}" Margin="26,22,26,24" />
        </Grid>
    </Grid>
</Window>
