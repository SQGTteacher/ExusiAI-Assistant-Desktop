<UserControl x:Class="ExusiAI.Desktop.MarketplacePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel>
            <TextBlock Text="扩展市场" Style="{StaticResource PageTitle}" />
            <TextBlock Text="发现插件、主题与服务提供器。" Style="{StaticResource PageSubtitle}" />
        </StackPanel>
        <Border Style="{StaticResource Card}" Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="34">
            <StackPanel HorizontalAlignment="Center">
                <Border Width="64" Height="64" CornerRadius="20" Background="{DynamicResource AccentSoftBrush}"><TextBlock Text="" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource AccentBrush}" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <TextBlock Text="{Binding Status}" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,22,0,0" />
                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,0" />
                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="9" Padding="12,8" Margin="0,22,0,0"><TextBlock Text="不会在未授权时连接网络" Foreground="{DynamicResource TextSecondaryBrush}" /></Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
