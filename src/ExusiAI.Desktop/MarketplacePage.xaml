<UserControl x:Class="ExusiAI.Desktop.MarketplacePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="本地资源库" Style="{StaticResource PageTitle}" /><TextBlock Text="发现已安装的插件与资源。" Style="{StaticResource PageSubtitle}" /></StackPanel>
        <Grid Grid.Row="1" Margin="0,24,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <ui:TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="搜索名称、发布者或插件 ID"
                        Icon="{ui:SymbolIcon Search24}" MinHeight="44" Margin="0,0,12,0" AutomationProperties.Name="搜索本地资源" />
            <ui:Button Grid.Column="1" Content="刷新" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RefreshCommand}" />
        </Grid>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,12"><Run Text="{Binding PackageCount, Mode=OneWay}" /><Run Text=" 个资源 · " /><Run Text="{Binding PublisherCount, Mode=OneWay}" /><Run Text=" 位发布者" /></TextBlock>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Packages}" Margin="0,0,8,0">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top" HorizontalAlignment="Left"><ui:SymbolIcon Symbol="Folder24" FontSize="22" Foreground="{DynamicResource AccentBrush}" /></Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                                    <WrapPanel Margin="0,12,0,0"><TextBlock Text="{Binding Publisher}" Style="{StaticResource Caption}" Margin="0,0,14,0" /><TextBlock Text="{Binding Version}" Style="{StaticResource Caption}" Margin="0,0,14,0" /><TextBlock Text="{Binding Type}" Style="{StaticResource Caption}" /></WrapPanel>
                                    <Expander Header="详细信息" Margin="0,12,0,0">
                                        <StackPanel Margin="0,8,0,0"><TextBlock Text="{Binding PackageId}" Style="{StaticResource Caption}" />
                                            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"><Run Text="API " /><Run Text="{Binding ApiVersion, Mode=OneWay}" /><Run Text=" · 依赖 " /><Run Text="{Binding DependencyCount, Mode=OneWay}" /><Run Text=" · 权限 " /><Run Text="{Binding PermissionCount, Mode=OneWay}" /></TextBlock>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360">
                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding PackageCount}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                <ui:SymbolIcon Symbol="Search24" FontSize="40" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Text="没有找到匹配的资源" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,0" />
                <TextBlock Text="试试其他关键词，或前往扩展管理导入插件。" Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>
            <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" VerticalAlignment="Bottom" />
        </Grid>
    </Grid>
</UserControl>
