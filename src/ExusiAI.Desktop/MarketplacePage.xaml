<UserControl x:Class="ExusiAI.Desktop.MarketplacePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel><TextBlock Text="扩展市场" Style="{StaticResource PageTitle}" /><TextBlock Text="未来用于发现经过校验的插件、主题与服务提供器。" Style="{StaticResource PageSubtitle}" /></StackPanel>
        <Border Style="{StaticResource Card}" Width="540" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30">
            <StackPanel HorizontalAlignment="Center">
                <Path Data="M4,7 H20 V20 H4 Z M8,7 V5 A4,4 0 0 1 16,5 V7 M8,12 H16" Width="38" Height="38" Stretch="Uniform" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" />
                <TextBlock Text="{Binding Status}" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0" />
                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" />
                <TextBlock Text="当前不会自动联网或下载内容" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,18,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
