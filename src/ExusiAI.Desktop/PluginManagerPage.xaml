<UserControl x:Class="ExusiAI.Desktop.PluginManagerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="扩展管理" Style="{StaticResource PageTitle}" />
            <TextBlock Text="管理课堂工具，按需启用。" Style="{StaticResource PageSubtitle}" />
            <WrapPanel Margin="0,20,0,0">
                <ui:Button Content="导入插件" Icon="{ui:SymbolIcon Add24}" Appearance="Primary" Command="{Binding ImportCommand}" Margin="0,0,10,8" />
                <ui:Button Content="打开插件目录" Icon="{ui:SymbolIcon Folder24}" Command="{Binding OpenPackagesFolderCommand}" Margin="0,0,0,8" />
            </WrapPanel>
            <TextBlock Text="{Binding OperationMessage}" Style="{StaticResource Caption}" Margin="0,4,0,6" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top" HorizontalAlignment="Left">
                                        <ui:SymbolIcon Symbol="Apps24" FontSize="22" Foreground="{DynamicResource AccentBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding State}" Style="{StaticResource Caption}" VerticalAlignment="Top" />
                                </Grid>
                                <TextBlock Style="{StaticResource Caption}" Margin="48,10,0,0"><Run Text="{Binding Publisher, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Version, Mode=OneWay}" /></TextBlock>
                                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="48,6,0,0" />
                                <WrapPanel Margin="48,12,0,0">
                                    <Button Content="{Binding ActionText}" Command="{Binding ToggleCommand}" IsEnabled="{Binding CanToggle}" MinWidth="80" Margin="0,0,8,4" />
                                    <Button Content="导出 ZIP" Command="{Binding ExportCommand}" Margin="0,0,8,4" />
                                    <Button Content="卸载" Command="{Binding UninstallCommand}" Style="{StaticResource GhostButton}" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,4" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="还没有安装扩展。导入插件包，添加你的课堂工具。" >
                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Entries.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding Failures}"><ItemsControl.ItemTemplate><DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,8,0,0"><StackPanel>
                        <TextBlock Text="{Binding Code}" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Message}" Style="{StaticResource Caption}" Margin="0,5,0,0" />
                    </StackPanel></Border>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
