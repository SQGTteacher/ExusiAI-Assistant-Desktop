<UserControl x:Class="ExusiAI.Desktop.SoftwareSettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="软件设置" Style="{StaticResource PageTitle}" />
            <TextBlock Text="检查版本、运行环境与本地数据位置。" Style="{StaticResource PageSubtitle}" />
            <TextBlock Text="应用信息" FontSize="17" FontWeight="SemiBold" Margin="0,23,0,10" />
            <Border Style="{StaticResource Card}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="ExusiAI Assistant Desktop" FontSize="17" FontWeight="SemiBold" /><TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0"><Run Text="{Binding Runtime}" /><Run Text="  ·  " /><Run Text="{Binding Architecture}" /></TextBlock><TextBlock Text="{Binding OperatingSystem}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" /></StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="{Binding Version}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" /><TextBlock Text="{Binding BuildNumber, StringFormat='build {0}'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Right" /><TextBlock Text="{Binding InstalledPackageCount, StringFormat='已发现 {0} 个包'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Right" /></StackPanel>
                </Grid>
            </Border>
            <TextBlock Text="本地目录" FontSize="17" FontWeight="SemiBold" Margin="0,20,0,10" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="用户数据" FontWeight="SemiBold" /><TextBlock Text="{Binding DataDirectory}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" /></StackPanel><Button Grid.Column="1" Content="打开" Command="{Binding OpenDataDirectoryCommand}" Margin="14,0,0,0" /></Grid>
                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,12" />
                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="用户插件包" FontWeight="SemiBold" /><TextBlock Text="{Binding PackagesDirectory}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" /></StackPanel><Button Grid.Column="1" Content="打开" Command="{Binding OpenPackagesDirectoryCommand}" Margin="14,0,0,0" /></Grid>
                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,12" />
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="运行日志" FontWeight="SemiBold" /><TextBlock Text="{Binding LogsDirectory}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" /></StackPanel><Button Grid.Column="1" Content="打开" Command="{Binding OpenLogsDirectoryCommand}" Margin="14,0,0,0" /></Grid>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="14" Margin="0,16,0,0"><StackPanel><TextBlock Text="本地数据策略" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" /><TextBlock Text="{Binding DataPolicy}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" /><TextBlock Text="{Binding LastActionMessage}" Foreground="{DynamicResource AccentBrush}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" /></StackPanel></Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
