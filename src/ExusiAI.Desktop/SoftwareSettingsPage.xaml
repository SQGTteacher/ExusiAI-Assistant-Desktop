<UserControl x:Class="ExusiAI.Desktop.SoftwareSettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="软件设置" Style="{StaticResource PageTitle}" />
        <TextBlock Text="基础信息与数据边界。" Style="{StaticResource PageSubtitle}" />
        <Border Style="{StaticResource Card}" Margin="0,24,0,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="ExusiAI Assistant Desktop" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Extension-first classroom platform" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" /></StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource AccentSoftBrush}" CornerRadius="999" Padding="12,6"><TextBlock Text="{Binding Version, StringFormat='版本 {0}'}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" /></Border>
            </Grid>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,12,0,0"><StackPanel><TextBlock Text="隐私" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="{Binding DataPolicy}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,7,0,0" /></StackPanel></Border>
        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="12" Padding="16" Margin="0,20,0,0"><TextBlock Text="第一阶段不包含账户、遥测、云端同步、自动更新或真实在线市场。" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" /></Border>
    </StackPanel>
</UserControl>
