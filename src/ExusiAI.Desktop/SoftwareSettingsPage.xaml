<UserControl x:Class="ExusiAI.Desktop.SoftwareSettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="软件设置" Style="{StaticResource PageTitle}" />
        <TextBlock Text="版本、构建与本地数据边界。" Style="{StaticResource PageSubtitle}" />
        <Border Style="{StaticResource Card}" Margin="0,24,0,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="ExusiAI Assistant Desktop" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Extension-first classroom platform" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" /></StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="{Binding Version}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" /><TextBlock Text="{Binding BuildNumber, StringFormat='build {0}'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Right" /></StackPanel>
            </Grid>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,10,0,0"><StackPanel><TextBlock Text="隐私" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="{Binding DataPolicy}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" /></StackPanel></Border>
        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="15" Margin="0,18,0,0"><TextBlock Text="Preview 版本不包含账户、遥测、云同步或自动更新。" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" /></Border>
    </StackPanel>
</UserControl>
