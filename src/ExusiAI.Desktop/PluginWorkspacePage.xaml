<UserControl x:Class="ExusiAI.Desktop.PluginWorkspacePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="插件工作台" Style="{StaticResource PageTitle}" />
            <TextBlock Text="你的课堂工具，集中在此。拖动标签可调整顺序。" Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <ListBox x:Name="PluginList" Grid.Row="1"
                 ItemsSource="{Binding Pages}"
                 SelectedItem="{Binding SelectedPage}"
                 AllowDrop="True"
                 PreviewMouseLeftButtonDown="PluginList_OnPreviewMouseLeftButtonDown"
                 PreviewMouseMove="PluginList_OnPreviewMouseMove"
                 PreviewTouchDown="PluginList_OnPreviewTouchDown"
                 PreviewTouchMove="PluginList_OnPreviewTouchMove"
                 PreviewTouchUp="PluginList_OnPreviewTouchUp"
                 PreviewKeyDown="PluginList_OnPreviewKeyDown"
                 DragOver="PluginList_OnDragOver"
                 Drop="PluginList_OnDrop"
                 AutomationProperties.HelpText="拖动插件卡片调整顺序，或按 Alt+方向键移动选中的插件。"
                 Margin="0,20,0,12" MaxHeight="144"
                 BorderThickness="0"
                 Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource SelectableItem}">
                    <Setter Property="MinWidth" Value="160" />
                    <Setter Property="Margin" Value="0,0,8,6" />
                    <Setter Property="Padding" Value="12,8" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="8"
                                Background="{DynamicResource SurfaceAltBrush}"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding IconGlyph}" FontSize="16"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   ToolTip="拖动调整顺序；也可按 Alt+方向键移动" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" ClipToBounds="True">
            <Grid>
                <ContentControl x:Name="ContentFrame" Content="{Binding CurrentPage}" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPages}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Path Data="M4,5 H20 V19 H4 Z M4,9 H20 M9,9 V19"
                          Width="36" Height="36" Stretch="Uniform"
                          Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" />
                    <TextBlock Text="没有可显示的插件页面" FontSize="17"
                               FontWeight="SemiBold" Margin="0,15,0,0"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="请在扩展管理中启用一个提供界面的插件。"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
