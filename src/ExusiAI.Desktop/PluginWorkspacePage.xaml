<UserControl x:Class="ExusiAI.Desktop.PluginWorkspacePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="插件工作台" Style="{StaticResource PageTitle}" />
            <TextBlock Text="插件不会占用主菜单；在这里选择一个当前工作页面。" Style="{StaticResource PageSubtitle}" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,22,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="176" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="6">
                <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" Style="{StaticResource NavigationList}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2"><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding IconGlyph}" FontSize="17" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding PackageId}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
                <Grid>
                    <ContentControl Content="{Binding CurrentPage}" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasPages}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <Path Data="M4,5 H20 V19 H4 Z M4,9 H20 M9,9 V19" Width="36" Height="36" Stretch="Uniform" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" />
                        <TextBlock Text="没有可显示的插件页面" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,0" HorizontalAlignment="Center" />
                        <TextBlock Text="请在扩展管理中启用一个提供界面的插件。" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,7,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
