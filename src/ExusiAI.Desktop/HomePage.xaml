<UserControl x:Class="ExusiAI.Desktop.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1120" HorizontalAlignment="Stretch" Margin="0,0,8,8">
            <TextBlock Text="欢迎回来" Style="{StaticResource PageTitle}" />
            <TextBlock Text="让工具各就其位，把时间留给课堂。" Style="{StaticResource PageSubtitle}" />
            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="10" Padding="28" Margin="0,26,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="96" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="准备好，开始上课。" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="课表、课件和课堂工具，在同一个工作台里就绪。" Style="{StaticResource PageSubtitle}" />
                        <ui:Button Content="打开插件工作台" Appearance="Primary" Icon="{ui:SymbolIcon Grid24}"
                                   HorizontalAlignment="Left" Margin="0,22,0,0"
                                   Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                   CommandParameter="workspace" />
                    </StackPanel>
                    <ui:SymbolIcon Grid.Column="1" Symbol="Board24" FontSize="80" Foreground="{DynamicResource AccentBrush}" Opacity="0.8" />
                </Grid>
            </Border>
            <TextBlock Text="常用入口" Style="{StaticResource SectionHeading}" />
            <UniformGrid Columns="2">
                <ui:CardAction Margin="0,0,6,12" Icon="{ui:SymbolIcon Apps24}"
                               Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="extensions">
                    <StackPanel><TextBlock Text="扩展管理" FontWeight="SemiBold" /><TextBlock Text="导入、启用和管理插件" Style="{StaticResource Caption}" Margin="0,5,0,0" /></StackPanel>
                </ui:CardAction>
                <ui:CardAction Margin="6,0,0,12" Icon="{ui:SymbolIcon Folder24}"
                               Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="marketplace">
                    <StackPanel><TextBlock Text="本地资源库" FontWeight="SemiBold" /><TextBlock Text="查找已经安装的资源" Style="{StaticResource Caption}" Margin="0,5,0,0" /></StackPanel>
                </ui:CardAction>
                <ui:CardAction Margin="0,0,6,0" Icon="{ui:SymbolIcon Color24}"
                               Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="theme">
                    <StackPanel><TextBlock Text="外观与主题" FontWeight="SemiBold" /><TextBlock Text="选择配色与窗口材质" Style="{StaticResource Caption}" Margin="0,5,0,0" /></StackPanel>
                </ui:CardAction>
                <ui:CardAction Margin="6,0,0,0" Icon="{ui:SymbolIcon Settings24}"
                               Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="settings">
                    <StackPanel><TextBlock Text="软件设置" FontWeight="SemiBold" /><TextBlock Text="版本信息、数据与日志" Style="{StaticResource Caption}" Margin="0,5,0,0" /></StackPanel>
                </ui:CardAction>
            </UniformGrid>
            <TextBlock Text="运行状态" Style="{StaticResource SectionHeading}" />
            <Border Background="{DynamicResource AppBackgroundBrush}" CornerRadius="8" Padding="20,16">
                <UniformGrid Columns="3">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding InstalledCount}" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="个扩展" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center" /></StackPanel>
                    <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding RunningCount}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" /><TextBlock Text="个运行中" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center" /></StackPanel>
                    <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding FailedCount}" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="项异常" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center" /></StackPanel>
                </UniformGrid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
